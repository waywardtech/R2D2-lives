[Unit]
Description=R2 non-actuating conversational service
After=network.target

[Service]
Type=simple
User=r2-chat
Group=r2-chat
WorkingDirectory=/opt/r2-runtime/current
Environment=PYTHONPATH=/opt/r2-runtime/current/r2-runtime/src
Environment=R2_CHAT_DATABASE=/var/lib/r2-runtime/chat/continuity.sqlite3
Environment=R2_STATUS_PATH=/var/lib/r2-runtime/dashboard/status.json
ExecStart=/opt/r2-runtime/chat-venv/bin/uvicorn r2_runtime.chat_api:create_app --factory --host 127.0.0.1 --port 8765 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/r2-runtime/chat
ReadOnlyPaths=/var/lib/r2-runtime/dashboard
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
